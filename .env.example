# === EODHD API ===
EODHD_API_KEY=your_api_key_here

# === HTTP Server ===
HTTP_HOST=0.0.0.0
HTTP_PORT=8765                    # Base port for API workers (8765, 8766, etc.)
API_KEY=your_secret_api_key_for_auth

# === Worker Configuration ===
# Multiple API workers for load balancing (configured in supervisord.conf)
# API workers: Handle HTTP requests (read-mostly operations)
# WebSocket worker: Handles tick processing and candle aggregation (single process)
# Default: 2 API workers + 1 WebSocket worker + 1 Admin UI
# Ports: API workers use 8765, 8766; WebSocket worker has no HTTP port

# === Default Tickers ===
DEFAULT_TICKERS=AAPL,MSFT,GOOGL,TSLA,NVDA

# === Ticker Management ===
ALLOW_DELETE_ALL_TICKERS=false   # Allow DELETE /tickers (without body) to remove all tickers

# === Candle Configuration ===
CANDLE_INTERVAL_MINUTES=5         # 1, 5, 15, 30, 60
MAX_CANDLES_STORED=100            # Per ticker
MAX_TICKERS=50                    # EODHD WebSocket limit

# === WebSocket ===
WS_RECONNECT_DELAY=5              # Seconds
WS_PING_INTERVAL=30               # Keep-alive ping
WS_STATUS_STALE_SECONDS=30        # Seconds after which WebSocket status is considered stale (multi-worker)

# === Ticker Sync (Multi-Worker Mode) ===
TICKER_SYNC_INTERVAL_SECONDS=30   # How often WebSocket worker polls DB for new/removed tickers (default: 30)

# === Database Performance Tuning ===
# SQLite retry configuration for handling lock contention
DB_MAX_RETRIES=5                  # Number of retry attempts on database lock (default: 3, recommended: 5)
DB_RETRY_BASE_DELAY_MS=100        # Base delay in milliseconds for exponential backoff (default: 50, recommended: 100)
DB_BUSY_TIMEOUT_MS=10000          # SQLite busy_timeout in milliseconds (default: 10000)

# === Candle Engine Performance Tuning ===
# Controls how often current (incomplete) candles are saved to database
# Higher values = less DB writes = better performance, but more data loss risk on crash
# Lower values = more DB writes = worse performance, but less data loss risk
CANDLE_SAVE_EVERY_N_TICKS=10      # Save current candle every N ticks (default: 10)
CANDLE_SAVE_EVERY_M_SECONDS=5.0   # Save current candle every M seconds (default: 5.0)
TICKER_STATUS_UPDATE_INTERVAL_SECONDS=1.0  # Flush/persist ticker heartbeat state interval (default: 1.0)
CANDLE_WRITE_QUEUE_MAXSIZE=10000  # Max queued candle writes before eviction/drop policy applies (default: 10000)
TICK_QUEUE_MAXSIZE=50000          # Max queued incoming ticks before drops (default: 50000)
TICK_WORKER_CONCURRENCY=100       # Number of async tick workers processing queue (default: 100)

# === Data Persistence ===
# Database backend: 'sqlite' (default) or 'postgres'
DATABASE_TYPE=sqlite

# SQLite Configuration (default)
# Auto-detects: /data/candles.db (Docker) or ./data/candles.db (local dev)
# Override only if you need a custom path
# DATABASE_PATH=/data/candles.db

# PostgreSQL Configuration (when DATABASE_TYPE=postgres)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=eodhd_candles
# POSTGRES_USER=eodhd_user
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_POOL_MIN=2
# POSTGRES_POOL_MAX=10

# === Runtime Configuration Persistence ===
# Persist config changes made via PATCH /config endpoint
PERSIST_CONFIG=true               # Save runtime config changes to survive restarts
# CONFIG_FILE=/data/config.json  # Auto-detects: /data/config.json (Docker) or ./data/config.json (local)
                                  # Override only if you need a custom path

# === Logging ===
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR

# === Admin Web UI ===
ADMIN_ENABLED=true                # Enable/disable admin web interface
ADMIN_HOST=127.0.0.1              # Admin UI bind address (127.0.0.1 for localhost only, 0.0.0.0 for external access)
ADMIN_PORT=5000                   # Admin UI port
