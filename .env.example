# === EODHD API ===
EODHD_API_KEY=your_api_key_here

# === HTTP Server ===
HTTP_HOST=0.0.0.0
HTTP_PORT=8765
API_KEY=your_secret_api_key_for_auth

# === Default Tickers ===
DEFAULT_TICKERS=AAPL,MSFT,GOOGL,TSLA,NVDA

# === Ticker Management ===
ALLOW_DELETE_ALL_TICKERS=false   # Allow DELETE /tickers (without body) to remove all tickers

# === Candle Configuration ===
CANDLE_INTERVAL_MINUTES=5         # 1, 5, 15, 30, 60
MAX_CANDLES_STORED=100            # Per ticker
MAX_TICKERS=50                    # EODHD WebSocket limit

# === WebSocket ===
WS_RECONNECT_DELAY=5              # Seconds
WS_PING_INTERVAL=30               # Keep-alive ping

# === Data Persistence ===
# Auto-detects: /data/candles.db (Docker) or ./data/candles.db (local dev)
# Override only if you need a custom path
# DATABASE_PATH=/data/candles.db

# === Logging ===
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR
